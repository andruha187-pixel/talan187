# ============================================================
# HOSTING / TELEGRAM
# ============================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PORT=8080
DATA_DIR=/var/data
LOG_LEVEL=INFO
SYMBOLS=BTC,XRP,BNB,SOL,ETH,DOGE,HYPE

# ============================================================
# PRE_LEAD_SAFE — keep frozen for the first LIVE forward test
# Candidate must still be below the old PRE_JUMP 0.40 threshold,
# but rising fast enough that the ~300ms projection is >=0.55.
# ============================================================
PRELEAD_MIN_SCORE=0.34
PRELEAD_TARGET_SCORE=0.40
PRELEAD_LOOKBACK_MS=300
PRELEAD_HORIZON_MS=300
PRELEAD_MIN_DELTA=0.015
PRELEAD_HISTORY_TOLERANCE_MS=180
PRELEAD_MIN_VENUES=2
PRELEAD_MIN_ELAPSED=1
PRELEAD_MAX_ELAPSED=160
PRELEAD_PRICE_MIN=0.52
PRELEAD_PRICE_MAX=0.66
PRELEAD_PM_MOM_MIN=-0.01
PRELEAD_PM_MOM_MAX=0.05
PRELEAD_SAFE_PROJECTED_SCORE=0.55
PRELEAD_SAFE_PRICE_MAX=0.56

# Dedicated PAPER mode inside this LIVE build can model the taker hold.
# LIVE does NOT sleep locally before ENTRY; it submits immediately.
PRELEAD_PAPER_SIM_DELAY_MS=250

# Entry is intentionally evaluated on the same 100ms cadence as the
# PRE_LEAD_SAFE forward test. An old EVENT_DRIVEN_LIVE_ENTRY value is ignored.
FAST_INTERVAL=0.10

# ============================================================
# ENTRY EXECUTION
# ============================================================
ENTRY_ORDER_SIZE=5
LIVE_ENTRY_MAX_SLIPPAGE=0.05
# One real FAK attempt by default, matching the lab's single delayed attempt.
PRELEAD_LIVE_NO_MATCH_RETRIES=0
LIVE_ENTRY_RETRY_DELAY_MS=0
LIVE_ENTRY_RETRY_FORCE_REST=0
LIVE_ENTRY_FORCE_REST_BOOK=0
MAX_BOOK_AGE_MS=1000
LIVE_MIN_SHARES=0.01
LIVE_MAX_SHARES_PER_ORDER=1000
LIVE_PRICE_TICK_FALLBACK=0.01

# Remove cold create/sign latency before a real signal.
LIVE_PREWARM_ENABLE=1
LIVE_PREWARM_INTERVAL_SEC=30
LIVE_PREWARM_LEAD_SEC=3
LIVE_PRESIGN_PREWARM_ENABLE=1
LIVE_PRESIGN_PREWARM_LEAD_SEC=12
LIVE_PRESIGN_PREWARM_SIZE=5

# ============================================================
# TAKE PROFIT — whole-position NET target
# Runtime value is adjustable in Telegram: TP 0.90, +/- TP, TP OFF, TP ENV.
# Existing /var/data state may override this ENV default until TP 0.90 is sent.
# ============================================================
TAKE_PROFIT_USDC=0.90
TAKE_PROFIT_MIN_USDC=0.10
TAKE_PROFIT_MAX_USDC=2.00
TAKE_PROFIT_STEP_USDC=0.10
EVENT_DRIVEN_LIVE_TP=1
LIVE_TP_EVENT_MIN_INTERVAL_MS=5
TP_CHECK_INTERVAL=0.75
LIVE_TP_MIN_HOLD_MS=2000
LIVE_TP_BALANCE_RETRY_DELAY_MS=1000

# PAPER accounting fallback if a token is deliberately left in PAPER mode.
PAPER_START_BALANCE=500
MIN_FREE_CASH=5
CRYPTO_FEE_RATE=0.07

# ============================================================
# LIVE SAFETY / WALLET
# Keep LIVE_MASTER_ENABLE=0 until WALLET reports READY.
# NEVER commit the private key to GitHub.
# ============================================================
LIVE_MASTER_ENABLE=0
POLYMARKET_PRIVATE_KEY=
POLYMARKET_WALLET_ADDRESS=
POLYMARKET_RELAYER_API_KEY=
POLYMARKET_RELAYER_API_KEY_ADDRESS=

# ============================================================
# PUBLIC EXTERNAL DATA SOURCES
# ============================================================
ENABLE_BINANCE=1
ENABLE_BYBIT=1
ENABLE_COINBASE=1
COINBASE_PRODUCTS=BTC:BTC-USD,ETH:ETH-USD,SOL:SOL-USD,XRP:XRP-USD,DOGE:DOGE-USD
BINANCE_WS_BASE=wss://fstream.binance.com/public/stream
BYBIT_WS=wss://stream.bybit.com/v5/public/linear
COINBASE_WS=wss://advanced-trade-ws.coinbase.com
EXT_VOTE_THRESHOLD=0.25
SOURCE_FRESH_MS=2500

# Housekeeping
TRAJECTORY_INTERVAL=3.0
DISCOVERY_INTERVAL=10
WS_MAX_CONNECTION_AGE_SEC=900
MEMORY_CLEANUP_INTERVAL=60
MEMORY_KEEP_RESOLVED_SEC=900
MEMORY_LOG_INTERVAL=300
