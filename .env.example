# ============================================================
# TELEGRAM / HOSTING
# ============================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PORT=8080
DATA_DIR=/var/data
LOG_LEVEL=INFO

# Tokens used by the strategy.
SYMBOLS=BTC,XRP,BNB,SOL,ETH,DOGE,HYPE

# ============================================================
# PRE-JUMP — default settings from the forward test
# Telegram can raise/lower SCORE at runtime, but never below 0.40.
# ============================================================
PREJUMP_SCORE=0.40
PREJUMP_PRICE_MIN=0.52
PREJUMP_PRICE_MAX=0.66
PREJUMP_MIN_VENUES=2
PREJUMP_MIN_ELAPSED=1
PREJUMP_MAX_ELAPSED=160
PREJUMP_PM_MOM_MIN=-0.01
PREJUMP_PM_MOM_MAX=0.05
PREJUMP_REQUIRE_BINANCE_BYBIT=0
EXT_VOTE_THRESHOLD=0.25
SOURCE_FRESH_MS=2500
FAST_INTERVAL=0.25

# ============================================================
# EXECUTION
# ============================================================
ENTRY_ORDER_SIZE=5
TAKE_PROFIT_USDC=0.60
PAPER_START_BALANCE=500
MIN_FREE_CASH=5
CRYPTO_FEE_RATE=0.07
MAX_BOOK_AGE_MS=1000
LIVE_MIN_SHARES=0.01
LIVE_MAX_SHARES_PER_ORDER=1000

# Fast PRE-JUMP LIVE entry protection/retry.
# FAK NO_MATCH is a deterministic zero fill, so one controlled retry is safe.
LIVE_ENTRY_MAX_SLIPPAGE=0.01
LIVE_ENTRY_NO_MATCH_RETRIES=1
LIVE_ENTRY_RETRY_DELAY_MS=150
LIVE_ENTRY_FORCE_REST_BOOK=1

# ============================================================
# LIVE SAFETY / WALLET
# Keep LIVE_MASTER_ENABLE=0 until WALLET says READY.
# NEVER commit the private key to GitHub.
# ============================================================
LIVE_MASTER_ENABLE=0
POLYMARKET_PRIVATE_KEY=
POLYMARKET_WALLET_ADDRESS=
POLYMARKET_RELAYER_API_KEY=
POLYMARKET_RELAYER_API_KEY_ADDRESS=

# ============================================================
# PUBLIC EXTERNAL DATA SOURCES
# ============================================================
ENABLE_BINANCE=1
ENABLE_BYBIT=1
ENABLE_COINBASE=1
COINBASE_PRODUCTS=BTC:BTC-USD,ETH:ETH-USD,SOL:SOL-USD,XRP:XRP-USD,DOGE:DOGE-USD
BINANCE_WS_BASE=wss://fstream.binance.com/public/stream
BYBIT_WS=wss://stream.bybit.com/v5/public/linear
COINBASE_WS=wss://advanced-trade-ws.coinbase.com

# Runtime load controls
TP_CHECK_INTERVAL=0.75
TRAJECTORY_INTERVAL=3.0
DISCOVERY_INTERVAL=10
WS_MAX_CONNECTION_AGE_SEC=900
MEMORY_CLEANUP_INTERVAL=60
MEMORY_KEEP_RESOLVED_SEC=900
MEMORY_LOG_INTERVAL=300
